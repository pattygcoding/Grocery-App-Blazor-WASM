@inject IJSRuntime JSRuntime

@* Three state theme control: an explicit light or dark choice, or follow the operating system. *@
<div class="theme-toggle" role="group" aria-label="Colour theme">
    @foreach (var option in Options)
    {
        <button type="button"
                class="theme-toggle__button"
                aria-pressed="@(preference == option.Value ? "true" : "false")"
                title="@option.Label"
                @onclick="() => SetThemeAsync(option.Value)">
            <Icon Name="@option.Icon" CssClass="icon-sm" />
            <span class="visually-hidden">@option.Label</span>
        </button>
    }
</div>

@code {
    private static readonly (string Value, string Label, string Icon)[] Options =
    {
        ("light", "Light theme", "sun-fill"),
        ("dark", "Dark theme", "moon-stars-fill"),
        ("system", "Match the system theme", "display")
    };

    private string preference = "system";

    protected override async Task OnInitializedAsync()
    {
        // index.html resolves the theme before paint; read that choice back so the control shows the
        // correct pressed state on its first render instead of flipping a frame later.
        try
        {
            preference = await JSRuntime.InvokeAsync<string>("groceryTheme.get");
        }
        catch (JSException)
        {
            // theme.js is unavailable (for example a browser still holding a cached index.html from
            // before this feature). The control falls back to the "system" state silently - logging
            // here would only add noise to the visitor's console for a self-healing cache condition.
        }
    }

    private async Task SetThemeAsync(string value)
    {
        try
        {
            preference = await JSRuntime.InvokeAsync<string>("groceryTheme.set", value);
        }
        catch (JSException)
        {
            // See above: without theme.js the toggle cannot persist a choice, so leave the current
            // state untouched rather than showing an error the visitor cannot act on.
        }
    }
}
