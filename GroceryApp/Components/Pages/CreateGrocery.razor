@page "/groceries/create"
@inject IGroceryService GroceryService
@inject NavigationManager Navigation

<PageTitle>Add grocery item</PageTitle>

<a class="back-link" href="/groceries">
    <Icon Name="arrow-left" CssClass="icon-sm" /> All groceries
</a>

<header class="page-header">
    <div class="page-header__text">
        <h1>Add a grocery item</h1>
        <p class="page-subtitle">
            New items are validated, then added to the catalogue.
        </p>
    </div>
</header>

<div class="panel panel--narrow">
    <div class="panel__body">
        @* novalidate: the app's own DataAnnotations validation is authoritative, so the browser's
           constraint validation must not swallow the submit event (for example when a price field
           starts at 0 but carries min="0.01"). *@
        <EditForm Model="@createModel" OnValidSubmit="@HandleValidSubmit" novalidate>
            <DataAnnotationsValidator />
            <ValidationSummary />

            @if (!string.IsNullOrEmpty(submitError))
            {
                <div class="alert alert--danger">
                    <p class="alert__title">
                        <Icon Name="exclamation-triangle" CssClass="icon-sm" /> The item could not be saved
                    </p>
                    <p class="mb-0">@submitError</p>
                </div>
            }

            <div class="form-grid">
                <div>
                    <label class="form-label" for="name">Name</label>
                    <InputText id="name" class="form-control" @bind-Value="createModel.Name" placeholder="Conference pear" />
                    <ValidationMessage For="() => createModel.Name" />
                </div>

                <div>
                    <label class="form-label" for="category">Category</label>
                    <InputSelect id="category" class="form-control" @bind-Value="createModel.Category">
                        <option value="">Select a category…</option>
                        @foreach (var category in Enum.GetValues<Category>())
                        {
                            <option value="@category">@category</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => createModel.Category" />
                </div>

                <div>
                    <label class="form-label" for="price">Unit price</label>
                    <InputNumber id="price" class="form-control" @bind-Value="createModel.Price" step="0.01" min="0.01" />
                    <ValidationMessage For="() => createModel.Price" />
                </div>

                <div>
                    <label class="form-label" for="cost">Cost to produce</label>
                    <InputNumber id="cost" class="form-control" @bind-Value="createModel.CostToProduce" step="0.01" min="0.01" />
                    <ValidationMessage For="() => createModel.CostToProduce" />
                </div>

                <div>
                    <label class="form-label" for="stock">Stock on hand</label>
                    <InputNumber id="stock" class="form-control" @bind-Value="createModel.Stock" min="0" />
                    <ValidationMessage For="() => createModel.Stock" />
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">
                    <Icon Name="plus-lg" /> Add item
                </button>
                <a class="btn btn-secondary" href="/groceries">Cancel</a>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private CreateGroceryItemDto createModel = new();
    private string? submitError;

    private async Task HandleValidSubmit()
    {
        submitError = null;

        try
        {
            await GroceryService.CreateGroceryAsync(createModel);
            Navigation.NavigateTo("/groceries");
        }
        catch (Exception ex)
        {
            submitError = "The item could not be written to browser storage. Please try again.";
            Console.WriteLine($"Error creating grocery item: {ex.Message}");
        }
    }
}
