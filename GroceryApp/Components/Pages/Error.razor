@page "/Error"

<PageTitle>Error - Grocery App</PageTitle>

<div class="panel">
    <div class="empty-state">
        <Icon Name="exclamation-triangle" CssClass="empty-state__icon" Size="24" />
        <h2>Something went wrong</h2>
        <p>
            The page could not be rendered. Reload the application to return to a clean state - your
            saved catalogue is not affected.
        </p>
        <div class="empty-state__actions">
            <a class="btn btn-primary" href="/">Back to home</a>
        </div>
    </div>
</div>
