@page "/groceries/delete/{id:int}"
@inject IGroceryService GroceryService
@inject NavigationManager Navigation

<PageTitle>Delete grocery item</PageTitle>

@if (grocery is null && !notFound)
{
    <div class="loading-state">
        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
        Loading item…
    </div>
}
else if (notFound)
{
    <div class="panel">
        <div class="empty-state">
            <Icon Name="exclamation-triangle" CssClass="empty-state__icon" Size="24" />
            <h2>Item not found</h2>
            <p>The grocery item you are trying to delete does not exist in this browser's catalogue.</p>
            <div class="empty-state__actions">
                <a class="btn btn-primary" href="/groceries">Back to groceries</a>
            </div>
        </div>
    </div>
}
else
{
    <a class="back-link" href="/groceries/@Id">
        <Icon Name="arrow-left" CssClass="icon-sm" /> Back to item
    </a>

    <header class="page-header">
        <div class="page-header__text">
            <h1>Delete @grocery!.Name</h1>
            <p class="page-subtitle">
                The item is removed from this browser's catalogue. This cannot be undone, although the
                demo data can be restored from the home page.
            </p>
        </div>
    </header>

    <div class="panel panel--danger panel--narrow">
        <div class="panel__header">
            <h2 class="panel__title">
                <Icon Name="exclamation-triangle" /> Confirm deletion
            </h2>
        </div>

        <div class="panel__body">
            @if (!string.IsNullOrEmpty(deleteError))
            {
                <div class="alert alert--danger">
                    <p class="alert__title">
                        <Icon Name="exclamation-triangle" CssClass="icon-sm" /> The item could not be deleted
                    </p>
                    <p class="mb-0">@deleteError</p>
                </div>
            }

            <dl class="detail-grid">
                <div class="detail-row">
                    <dt>Name</dt>
                    <dd>@grocery.Name</dd>
                </div>
                <div class="detail-row">
                    <dt>Category</dt>
                    <dd><span class="chip @CategoryChip.ClassFor(grocery.Category)">@grocery.Category</span></dd>
                </div>
                <div class="detail-row">
                    <dt>Unit price</dt>
                    <dd class="tnum">@grocery.Price.ToString("C2")</dd>
                </div>
                <div class="detail-row">
                    <dt>Stock on hand</dt>
                    <dd class="tnum">@grocery.Stock</dd>
                </div>
                <div class="detail-row">
                    <dt>Created</dt>
                    <dd>@grocery.CreatedUtc.ToString("d MMM yyyy, HH:mm") UTC</dd>
                </div>
            </dl>

            <EditForm Model="@this" OnSubmit="@HandleDelete" novalidate>
                <div class="form-actions">
                    <button type="submit" class="btn btn-danger" disabled="@isDeleting">
                        @if (isDeleting)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        }
                        <Icon Name="trash3" /> Delete item
                    </button>
                    <a class="btn btn-secondary" href="/groceries/@Id">Cancel</a>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private GroceryItemDto? grocery;
    private bool notFound;
    private bool isDeleting;
    private string? deleteError;

    protected override async Task OnInitializedAsync()
    {
        grocery = await GroceryService.GetGroceryByIdAsync(Id);
        notFound = grocery is null;
    }

    private async Task HandleDelete()
    {
        if (grocery is null)
        {
            return;
        }

        isDeleting = true;
        deleteError = null;

        try
        {
            var deleted = await GroceryService.DeleteGroceryAsync(Id);

            if (!deleted)
            {
                notFound = true;
                return;
            }

            Navigation.NavigateTo("/groceries");
        }
        catch (Exception ex)
        {
            deleteError = "The item could not be removed from browser storage. Please try again.";
            Console.WriteLine($"Error deleting grocery item: {ex.Message}");
        }
        finally
        {
            isDeleting = false;
        }
    }
}
