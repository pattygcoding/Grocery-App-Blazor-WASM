@page "/groceries"
@inject IGroceryService GroceryService

<PageTitle>Groceries</PageTitle>

<header class="page-header">
    <div class="page-header__text">
        <h1>Grocery items</h1>
        <p class="page-subtitle">
            @if (groceries is null)
            {
                <text>Loading the catalogue from this browser…</text>
            }
            else
            {
                <text>@groceries.Count() items across @CategoryCount categories, ordered by category and name.</text>
            }
        </p>
    </div>

    <div class="page-actions">
        <a class="btn btn-primary" href="/groceries/create">
            <Icon Name="plus-lg" /> Add item
        </a>
    </div>
</header>

@if (groceries is null)
{
    <div class="loading-state">
        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
        Loading catalogue…
    </div>
}
else if (!groceries.Any())
{
    <div class="panel">
        <div class="empty-state">
            <Icon Name="basket3-fill" CssClass="empty-state__icon" Size="24" />
            <h2>No items in the catalogue</h2>
            <p>The catalogue is empty. Add an item, or restore the demo data from the home page.</p>
            <div class="empty-state__actions">
                <a class="btn btn-primary" href="/groceries/create">Add item</a>
                <a class="btn btn-secondary" href="/">Restore demo data</a>
            </div>
        </div>
    </div>
}
else
{
    <div class="category-grid">
        @foreach (var category in Enum.GetValues<Category>())
        {
            var itemsInCategory = groceries.Where(g => g.Category == category).ToList();

            if (itemsInCategory.Count == 0)
            {
                continue;
            }

            <section class="panel">
                <div class="panel__header">
                    <h2 class="panel__title">
                        <span class="chip @CategoryChip.ClassFor(category)">@category</span>
                    </h2>
                    <span class="text-subtle">
                        @itemsInCategory.Count item@(itemsInCategory.Count == 1 ? string.Empty : "s") ·
                        @itemsInCategory.Sum(i => i.Stock) in stock
                    </span>
                </div>

                <div class="panel__body panel__body--flush">
                    <div class="item-list">
                        @foreach (var item in itemsInCategory)
                        {
                            <article class="item-row">
                                <div class="item-row__main">
                                    <div class="item-row__head">
                                        <a class="item-row__name" href="/groceries/@item.Id">@item.Name</a>
                                        <span class="item-row__id">#@item.Id</span>
                                    </div>

                                    <div class="item-row__figures">
                                        <span>Price <span class="item-row__figure-value">@item.Price.ToString("C2")</span></span>
                                        <span>Cost <span class="item-row__figure-value">@item.CostToProduce.ToString("C2")</span></span>
                                        <span>
                                            Margin
                                            <span class="item-row__figure-value text-positive">@((item.Price - item.CostToProduce).ToString("C2"))</span>
                                        </span>
                                    </div>
                                </div>

                                <div class="item-row__aside">
                                    <div class="item-row__stock">
                                        <span class="item-row__label">Stock</span>
                                        <div class="stepper">
                                            <button type="button"
                                                    class="stepper__button"
                                                    @onclick="() => AdjustStock(item.Id, -1)"
                                                    disabled="@(item.Stock <= 0)"
                                                    aria-label="@("Decrease stock for " + item.Name)">
                                                &minus;
                                            </button>
                                            <span class="stepper__value" aria-live="polite">@item.Stock</span>
                                            <button type="button"
                                                    class="stepper__button"
                                                    @onclick="() => AdjustStock(item.Id, 1)"
                                                    aria-label="@("Increase stock for " + item.Name)">
                                                +
                                            </button>
                                        </div>
                                    </div>

                                    <div class="row-actions">
                                        <a class="btn btn-ghost btn-sm" href="/groceries/@item.Id">View</a>
                                        <a class="btn btn-ghost btn-sm" href="/groceries/edit/@item.Id">Edit</a>
                                        <a class="btn btn-outline-danger btn-sm" href="/groceries/delete/@item.Id">Delete</a>
                                    </div>
                                </div>
                            </article>
                        }
                    </div>
                </div>
            </section>
        }
    </div>
}

@code {
    private IEnumerable<GroceryItemDto>? groceries;

    private int CategoryCount => groceries?.Select(g => g.Category).Distinct().Count() ?? 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadGroceries();
    }

    private async Task LoadGroceries()
    {
        groceries = await GroceryService.GetAllGroceriesAsync();
    }

    private async Task AdjustStock(int id, int adjustment)
    {
        await GroceryService.AdjustStockAsync(id, adjustment);
        await LoadGroceries();
    }
}
