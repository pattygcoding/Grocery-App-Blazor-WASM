@page "/"
@inject IGroceryService GroceryService
@inject IDemoScenarioService DemoScenario

<PageTitle>Grocery catalogue - Blazor WebAssembly</PageTitle>

<section class="hero">
    <span class="chip chip--brand">Blazor WebAssembly · .NET 8 · personal project</span>
    <h1>A grocery catalogue built with Blazor WebAssembly</h1>
    <p class="hero__lead">
        I built this to keep track of the groceries I price and restock: add items, adjust stock and
        review margins, with C# running in the browser and the Excel workbook written on the client.
    </p>

    <div class="hero__actions">
        <a class="btn btn-primary btn-lg" href="/groceries">
            <Icon Name="basket3-fill" /> Open groceries
        </a>
        <a class="btn btn-secondary btn-lg" href="/dashboard">
            <Icon Name="graph-up" /> View the dashboard
        </a>
        <a class="btn btn-secondary btn-lg" href="/reports">
            <Icon Name="bar-chart-fill" /> Reports
        </a>
    </div>

    <div class="hero__meta">
        <div>
            <span class="hero__meta-label">Seeded items</span>
            <span class="hero__meta-value tnum">50</span>
        </div>
        <div>
            <span class="hero__meta-label">Categories</span>
            <span class="hero__meta-value tnum">5</span>
        </div>
        <div>
            <span class="hero__meta-label">Persistence</span>
            <span class="hero__meta-value">localStorage</span>
        </div>
        <div>
            <span class="hero__meta-label">Written in</span>
            <span class="hero__meta-value">C#</span>
        </div>
    </div>
</section>

<h2 class="section-title">What's in it</h2>

<div class="panel-grid">
    <article class="panel">
        <div class="panel__body">
            <span class="feature__icon"><Icon Name="graph-up" Size="18" /></span>
            <h3 class="feature__title">Dashboard</h3>
            <p class="feature__text">
                What the stock is worth, what it would earn, what has moved in the last thirty days and
                what that is worth against the thirty before it.
            </p>
        </div>
    </article>

    <article class="panel">
        <div class="panel__body">
            <span class="feature__icon"><Icon Name="activity" Size="18" /></span>
            <h3 class="feature__title">A sense of time</h3>
            <p class="feature__text">
                Every movement is logged, so the app can work out how fast things sell, how long the stock
                on the shelf lasts and which lines have gone quiet.
            </p>
        </div>
    </article>

    <article class="panel">
        <div class="panel__body">
            <span class="feature__icon"><Icon Name="funnel-fill" Size="18" /></span>
            <h3 class="feature__title">Find anything</h3>
            <p class="feature__text">
                Search by name, code, supplier or tag, narrow by category, stock position and value band,
                and the view you end up with is in the address bar to keep.
            </p>
        </div>
    </article>

    <article class="panel">
        <div class="panel__body">
            <span class="feature__icon"><Icon Name="search" Size="18" /></span>
            <h3 class="feature__title">Keyboard first</h3>
            <p class="feature__text">
                <kbd class="palette__key">Ctrl</kbd> <kbd class="palette__key">K</kbd> opens a palette over
                every page, every item and the actions worth reaching, and
                <kbd class="palette__key">Ctrl</kbd> <kbd class="palette__key">Z</kbd> puts the last change
                back from wherever you are. <kbd class="palette__key">?</kbd> lists the rest.
            </p>
        </div>
    </article>

    <article class="panel">
        <div class="panel__body">
            <span class="feature__icon"><Icon Name="plus-lg" Size="18" /></span>
            <h3 class="feature__title">The catalogue</h3>
            <p class="feature__text">
                Add, edit and delete items, with name, category, price, cost and stock all validated.
            </p>
        </div>
    </article>

    <article class="panel">
        <div class="panel__body">
            <span class="feature__icon"><Icon Name="grid-3x3-gap" Size="18" /></span>
            <h3 class="feature__title">Five categories</h3>
            <p class="feature__text">
                Fruits, vegetables, meats, cheeses and breads, grouped into cards with a count for each.
            </p>
        </div>
    </article>

    <article class="panel">
        <div class="panel__body">
            <span class="feature__icon"><Icon Name="boxes" Size="18" /></span>
            <h3 class="feature__title">Stock control</h3>
            <p class="feature__text">
                Nudge stock straight from the list with the - and + buttons, or open an item to change
                everything at once.
            </p>
        </div>
    </article>

    <article class="panel">
        <div class="panel__body">
            <span class="feature__icon"><Icon Name="bar-chart-fill" Size="18" /></span>
            <h3 class="feature__title">Reports</h3>
            <p class="feature__text">
                Profit potential, category performance, stock coverage and price bands, worked out as you go.
            </p>
        </div>
    </article>

    <article class="panel">
        <div class="panel__body">
            <span class="feature__icon"><Icon Name="file-earmark-spreadsheet" Size="18" /></span>
            <h3 class="feature__title">Excel export</h3>
            <p class="feature__text">
                An eight sheet workbook written as Open XML in C#, downloaded straight from the page. The last
                sheet is a list of lines to do something about, with the reason beside each one.
            </p>
        </div>
    </article>

    <article class="panel">
        <div class="panel__body">
            <span class="feature__icon"><Icon Name="database" Size="18" /></span>
            <h3 class="feature__title">Saved in your browser</h3>
            <p class="feature__text">
                The catalogue is kept in localStorage, so it is still there the next time you open the page.
            </p>
        </div>
    </article>
</div>

<h2 class="section-title">How it is built</h2>

<div class="split">
    <section class="panel">
        <div class="panel__header">
            <h3 class="panel__title"><Icon Name="code-slash" /> Architecture</h3>
        </div>
        <div class="panel__body">
            <ul class="list-check">
                <li>
                    <Icon Name="check2-circle" CssClass="icon-sm" />
                    <span>Blazor WebAssembly on .NET 8 - C# compiled to WebAssembly and running in the browser</span>
                </li>
                <li>
                    <Icon Name="check2-circle" CssClass="icon-sm" />
                    <span>Repository pattern over a storage abstraction, so the storage engine is replaceable</span>
                </li>
                <li>
                    <Icon Name="check2-circle" CssClass="icon-sm" />
                    <span>localStorage persistence through JS interop, with an in-memory fallback</span>
                </li>
                <li>
                    <Icon Name="check2-circle" CssClass="icon-sm" />
                    <span>Hand-written Open XML workbook writer behind the Excel export</span>
                </li>
                <li>
                    <Icon Name="check2-circle" CssClass="icon-sm" />
                    <span>xUnit and NSubstitute suite covering the service, repository and export layers</span>
                </li>
            </ul>
        </div>
    </section>

    <section class="panel">
        <div class="panel__header">
            <h3 class="panel__title"><Icon Name="grid-3x3-gap" /> Seeded catalogue</h3>
        </div>
        <div class="panel__body">
            <p class="feature__text">
                I seeded 50 demo items, spread evenly across the five categories, so there is something
                to poke at straight away.
            </p>
            <div class="tag-cloud mt-3">
                @foreach (var category in Enum.GetValues<Category>())
                {
                    <span class="chip @CategoryChip.ClassFor(category)">@category · 10</span>
                }
            </div>
        </div>
    </section>
</div>

<h2 class="section-title">Legacy reference and demo data</h2>

<div class="split">
    <section class="panel">
        <div class="panel__header">
            <h3 class="panel__title"><Icon Name="github" /> Ported from my Blazor Server app</h3>
        </div>
        <div class="panel__body">
            <p class="feature__text">
                This is my second pass at the same idea. The original was written with Blazor Server,
                EF Core, SQLite and ClosedXML reports, and I kept that repository up for reference.
            </p>
            <div class="row-actions mt-3">
                <a class="btn btn-secondary" href="https://github.com/pattygcoding/Grocery-App-Blazor" target="_blank" rel="noopener">
                    <Icon Name="github" /> Legacy repository
                </a>
                <a class="btn btn-ghost" href="https://github.com/pattygcoding/Grocery-App-Blazor-WASM" target="_blank" rel="noopener">
                    <Icon Name="box-arrow-up-right" /> Source of this app
                </a>
            </div>
        </div>
    </section>

    <section class="panel">
        <div class="panel__header">
            <h3 class="panel__title"><Icon Name="arrow-counterclockwise" /> Demo data</h3>
        </div>
        <div class="panel__body">
            <p class="feature__text">
                Everything you change is kept in this browser, so feel free to experiment. Restore the
                original 50 items whenever you like.
            </p>
            <button class="btn btn-secondary mt-3" @onclick="ResetDemoData" disabled="@isResetting">
                @if (isResetting)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                }
                <Icon Name="arrow-counterclockwise" /> Reset demo data
            </button>

            @if (!string.IsNullOrEmpty(statusMessage))
            {
                <div class="alert alert--info mt-3 mb-0">@statusMessage</div>
            }
        </div>
    </section>
</div>

<h2 class="section-title">Request flow</h2>

<div class="panel">
    <div class="panel__body">
        <p class="flow mb-0">
            Pages
            <Icon Name="chevron-right" CssClass="flow__arrow" />
            <code>IGroceryService</code>
            <Icon Name="chevron-right" CssClass="flow__arrow" />
            <code>IGroceryRepository</code>
            <Icon Name="chevron-right" CssClass="flow__arrow" />
            <code>IGroceryStore</code>
            <Icon Name="chevron-right" CssClass="flow__arrow" />
            <code>localStorage</code>
        </p>

        <p class="flow mt-3 mb-0">
            Pages
            <Icon Name="chevron-right" CssClass="flow__arrow" />
            <code>IInventoryAnalyticsService</code>
            <Icon Name="chevron-right" CssClass="flow__arrow" />
            <code>IActivityService</code>
            <Icon Name="chevron-right" CssClass="flow__arrow" />
            <code>localStorage</code>
        </p>
    </div>
</div>

@code {
    private bool isResetting;
    private string? statusMessage;

    private async Task ResetDemoData()
    {
        isResetting = true;
        statusMessage = null;

        try
        {
            // The catalogue goes back to the seeded fifty and the log goes with it, because the log described
            // items that no longer exist. The demonstration history is then rebuilt, so the dashboard and the
            // restock worksheet are not left describing a catalogue that has gone.
            await GroceryService.ResetDemoDataAsync();

            var scenario = await DemoScenario.RebuildAsync(DateTime.UtcNow);

            statusMessage = scenario.Applied
                ? $"Demo data restored - the original 50 items are back, with {scenario.EntriesCreated} movements recorded against them."
                : "Demo data restored - the original 50 items are back in the catalogue.";
        }
        catch (Exception ex)
        {
            statusMessage = "The demo data could not be restored. Reload the application and try again.";
            Console.WriteLine($"Error resetting demo data: {ex.Message}");
        }
        finally
        {
            isResetting = false;
        }
    }
}
