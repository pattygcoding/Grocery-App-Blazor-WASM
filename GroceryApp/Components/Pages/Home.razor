@page "/"
@inject IGroceryService GroceryService

<PageTitle>Grocery catalogue - Blazor WebAssembly</PageTitle>

<section class="hero">
    <span class="chip chip--brand">Blazor WebAssembly · .NET 8 · GitHub Pages</span>
    <h1>Grocery catalogue management, entirely in the browser</h1>
    <p class="hero__lead">
        Add items, adjust stock and review margins without a back end. C# runs on WebAssembly, the
        catalogue is persisted to this browser, and the analytics workbook is generated on the client.
    </p>

    <div class="hero__actions">
        <a class="btn btn-primary btn-lg" href="/groceries">
            <Icon Name="basket3-fill" /> Open groceries
        </a>
        <a class="btn btn-secondary btn-lg" href="/reports">
            <Icon Name="bar-chart-fill" /> View reports
        </a>
    </div>

    <div class="hero__meta">
        <div>
            <span class="hero__meta-label">Seeded items</span>
            <span class="hero__meta-value tnum">50</span>
        </div>
        <div>
            <span class="hero__meta-label">Categories</span>
            <span class="hero__meta-value tnum">5</span>
        </div>
        <div>
            <span class="hero__meta-label">Persistence</span>
            <span class="hero__meta-value">localStorage</span>
        </div>
        <div>
            <span class="hero__meta-label">Backend services</span>
            <span class="hero__meta-value tnum">0</span>
        </div>
    </div>
</section>

<h2 class="section-title">What it does</h2>

<div class="panel-grid">
    <article class="panel">
        <div class="panel__body">
            <span class="feature__icon"><Icon Name="plus-lg" Size="18" /></span>
            <h3 class="feature__title">Catalogue management</h3>
            <p class="feature__text">
                Create, edit and delete items with validated name, category, price, cost and stock fields.
            </p>
        </div>
    </article>

    <article class="panel">
        <div class="panel__body">
            <span class="feature__icon"><Icon Name="grid-3x3-gap" Size="18" /></span>
            <h3 class="feature__title">Category organisation</h3>
            <p class="feature__text">
                Fruits, vegetables, meats, cheeses and breads, grouped as cards with per-category counts.
            </p>
        </div>
    </article>

    <article class="panel">
        <div class="panel__body">
            <span class="feature__icon"><Icon Name="database" Size="18" /></span>
            <h3 class="feature__title">Browser persistence</h3>
            <p class="feature__text">
                The catalogue is written to localStorage through JS interop, so changes survive a reload
                without a server. Reset the demo data at any time.
            </p>
        </div>
    </article>

    <article class="panel">
        <div class="panel__body">
            <span class="feature__icon"><Icon Name="bar-chart-fill" Size="18" /></span>
            <h3 class="feature__title">Analytics</h3>
            <p class="feature__text">
                Profit potential, category performance, stock coverage and price bands, all computed on the fly.
            </p>
        </div>
    </article>

    <article class="panel">
        <div class="panel__body">
            <span class="feature__icon"><Icon Name="file-earmark-spreadsheet" Size="18" /></span>
            <h3 class="feature__title">Excel export</h3>
            <p class="feature__text">
                A five sheet workbook is written as Open XML in C# in the browser - no ClosedXML, no server round trip.
            </p>
        </div>
    </article>

    <article class="panel">
        <div class="panel__body">
            <span class="feature__icon"><Icon Name="shield-check" Size="18" /></span>
            <h3 class="feature__title">Validation</h3>
            <p class="feature__text">
                Data annotations drive field level validation and user feedback on every form.
            </p>
        </div>
    </article>
</div>

<h2 class="section-title">How it is built</h2>

<div class="split">
    <section class="panel">
        <div class="panel__header">
            <h3 class="panel__title"><Icon Name="code-slash" /> Architecture</h3>
        </div>
        <div class="panel__body">
            <ul class="list-check">
                <li>
                    <Icon Name="check2-circle" CssClass="icon-sm" />
                    <span>Blazor WebAssembly on .NET 8 - C# compiled to WebAssembly, served as static files</span>
                </li>
                <li>
                    <Icon Name="check2-circle" CssClass="icon-sm" />
                    <span>Repository pattern over a storage abstraction, so the storage engine is replaceable</span>
                </li>
                <li>
                    <Icon Name="check2-circle" CssClass="icon-sm" />
                    <span>localStorage persistence through JS interop, with an in-memory fallback</span>
                </li>
                <li>
                    <Icon Name="check2-circle" CssClass="icon-sm" />
                    <span>Open XML workbook writer with no third party dependencies</span>
                </li>
                <li>
                    <Icon Name="check2-circle" CssClass="icon-sm" />
                    <span>xUnit and NSubstitute suite covering the service, repository and export layers</span>
                </li>
            </ul>
        </div>
    </section>

    <section class="panel">
        <div class="panel__header">
            <h3 class="panel__title"><Icon Name="grid-3x3-gap" /> Seeded catalogue</h3>
        </div>
        <div class="panel__body">
            <p class="feature__text">
                50 demo items spread evenly across the five categories. The seed data ships inside the
                assembly and is written to this browser on first load.
            </p>
            <div class="tag-cloud mt-3">
                @foreach (var category in Enum.GetValues<Category>())
                {
                    <span class="chip @CategoryChip.ClassFor(category)">@category · 10</span>
                }
            </div>
        </div>
    </section>
</div>

<h2 class="section-title">Legacy reference and demo data</h2>

<div class="split">
    <section class="panel">
        <div class="panel__header">
            <h3 class="panel__title"><Icon Name="github" /> Ported from the Blazor Server application</h3>
        </div>
        <div class="panel__body">
            <p class="feature__text">
                This WebAssembly build is a front-end only port of the original full-stack application:
                Blazor Server with EF Core, SQLite and ClosedXML reports. That repository is kept for reference.
            </p>
            <div class="row-actions mt-3">
                <a class="btn btn-secondary" href="https://github.com/pattygcoding/Grocery-App-Blazor" target="_blank" rel="noopener">
                    <Icon Name="github" /> Legacy repository
                </a>
                <a class="btn btn-ghost" href="https://github.com/pattygcoding/Grocery-App-Blazor-WASM" target="_blank" rel="noopener">
                    <Icon Name="box-arrow-up-right" /> Source of this app
                </a>
            </div>
        </div>
    </section>

    <section class="panel">
        <div class="panel__header">
            <h3 class="panel__title"><Icon Name="arrow-counterclockwise" /> Demo data</h3>
        </div>
        <div class="panel__body">
            <p class="feature__text">
                Every change is stored in this browser only. Restore the original 50 items whenever you like.
            </p>
            <button class="btn btn-secondary mt-3" @onclick="ResetDemoData" disabled="@isResetting">
                @if (isResetting)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                }
                <Icon Name="arrow-counterclockwise" /> Reset demo data
            </button>

            @if (!string.IsNullOrEmpty(statusMessage))
            {
                <div class="alert alert--info mt-3 mb-0">@statusMessage</div>
            }
        </div>
    </section>
</div>

<h2 class="section-title">Request flow</h2>

<div class="panel">
    <div class="panel__body">
        <p class="flow mb-0">
            Pages
            <Icon Name="chevron-right" CssClass="flow__arrow" />
            <code>IGroceryService</code>
            <Icon Name="chevron-right" CssClass="flow__arrow" />
            <code>IGroceryRepository</code>
            <Icon Name="chevron-right" CssClass="flow__arrow" />
            <code>IGroceryStore</code>
            <Icon Name="chevron-right" CssClass="flow__arrow" />
            <code>localStorage</code>
        </p>
    </div>
</div>

@code {
    private bool isResetting;
    private string? statusMessage;

    private async Task ResetDemoData()
    {
        isResetting = true;
        statusMessage = null;

        try
        {
            await GroceryService.ResetDemoDataAsync();
            statusMessage = "Demo data restored - the original 50 items are back in the catalogue.";
        }
        catch (Exception ex)
        {
            statusMessage = "The demo data could not be restored. Reload the application and try again.";
            Console.WriteLine($"Error resetting demo data: {ex.Message}");
        }
        finally
        {
            isResetting = false;
        }
    }
}
