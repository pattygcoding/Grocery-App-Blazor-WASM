@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <a href="https://github.com/pattygcoding/Grocery-App-Blazor" target="_blank" rel="noopener">Legacy Blazor Server app</a>
            <a href="https://github.com/pattygcoding/Grocery-App-Blazor-WASM" target="_blank" rel="noopener">Source</a>
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank" rel="noopener">About</a>
        </div>

        <article class="content px-4">
            @Body
        </article>

        <footer class="app-footer px-4">
            <small>
                Front-end only Blazor WebAssembly port of the
                <a href="https://github.com/pattygcoding/Grocery-App-Blazor" target="_blank" rel="noopener">legacy Blazor Server application</a>
                (Blazor Server + EF Core + SQLite with ClosedXML reports). This version has no server,
                database or API - everything runs in your browser.
            </small>
        </footer>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
