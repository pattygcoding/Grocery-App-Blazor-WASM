@inherits LayoutComponentBase

<div class="app-shell">
    <aside class="app-sidebar">
        <NavMenu />
    </aside>

    <div class="app-main">
        <header class="app-topbar">
            <p class="app-topbar__note">Demo data stays in this browser - nothing is uploaded.</p>

            <div class="app-topbar__links">
                <a class="topbar-link" href="https://github.com/pattygcoding/Grocery-App-Blazor" target="_blank" rel="noopener">
                    <Icon Name="github" CssClass="icon-sm" />
                    Legacy Blazor Server app
                </a>
                <a class="topbar-link" href="https://github.com/pattygcoding/Grocery-App-Blazor-WASM" target="_blank" rel="noopener">
                    <Icon Name="code-slash" CssClass="icon-sm" />
                    Source
                </a>
            </div>
        </header>

        <main class="app-content">
            @Body
        </main>

        <footer class="app-footer">
            <p>
                Front-end only Blazor WebAssembly port of the
                <a href="https://github.com/pattygcoding/Grocery-App-Blazor" target="_blank" rel="noopener">legacy Blazor Server application</a>
                (Blazor Server with EF Core, SQLite and ClosedXML reports). This build has no server,
                database or API: the catalogue is stored in your browser and the Excel workbook is
                generated in C# on the client.
            </p>
        </footer>
    </div>
</div>
