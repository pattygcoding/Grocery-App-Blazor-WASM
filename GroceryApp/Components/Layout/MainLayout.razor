@inherits LayoutComponentBase

<div class="app-shell">
    <aside class="app-sidebar">
        <NavMenu />
    </aside>

    <div class="app-main">
        <header class="app-topbar">
            <p class="app-topbar__note">Your changes are saved in this browser.</p>

            <div class="app-topbar__actions">
                <div class="app-topbar__links">
                    <a class="topbar-link" href="https://github.com/pattygcoding/Grocery-App-Blazor" target="_blank" rel="noopener">
                        <Icon Name="github" CssClass="icon-sm" />
                        Legacy Blazor Server app
                    </a>
                    <a class="topbar-link" href="https://github.com/pattygcoding/Grocery-App-Blazor-WASM" target="_blank" rel="noopener">
                        <Icon Name="code-slash" CssClass="icon-sm" />
                        Source
                    </a>
                </div>

                <ThemeToggle />
            </div>
        </header>

        <main class="app-content">
            @Body
        </main>

        <footer class="app-footer">
            <p>
                A personal project by
                <a href="https://pattygcoding.com" target="_blank" rel="noopener">Patrick Goodwin</a>.
                Blazor WebAssembly rewrite of my original Blazor Server app, which used EF Core, SQLite
                and ClosedXML reports - that version is still up
                <a href="https://github.com/pattygcoding/Grocery-App-Blazor" target="_blank" rel="noopener">on GitHub</a>.
            </p>
        </footer>
    </div>
</div>
